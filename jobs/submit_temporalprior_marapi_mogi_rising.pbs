#!/bin/bash
# Usage:       qsub jobs/submit_temporalprior_marapi_mogi_rising.pbs
# Description: Option A (causal per-sample TEMPORAL PRIOR) on the synthetic RISING Mogi
#              test case (marapi_mogi_rising_combined: constant location, dV rises over
#              epochs). SINGLE training run (replaces the O(N) iterprior driver): the
#              u_phy KL prior mean for epoch t is pulled toward epoch (t-1)'s current
#              estimate via an online EMA buffer, with a tight location / loose amplitude
#              variance split. Then dumps the per-epoch u-space series and plots the
#              recovered parameters vs the synthetic ground truth.
# Date:        2026-07-09
#PBS -N tprior_rising
#PBS -P eos_btaisne
#PBS -q qintel_wfly
#PBS -l nodes=1:ppn=8
#PBS -l walltime=12:00:00
#PBS -l mem=16gb
#PBS -j oe
#PBS -o logs/tprior_rising_pbs.log

set -e
cd "$PBS_O_WORKDIR"

# --- Environment (project env is 'pila', NOT base) ---
source /eos-rs/miniconda3/etc/profile.d/conda.sh
conda activate pila
export PYTHONPATH="${PYTHONPATH}:$PBS_O_WORKDIR"

echo "[tprior_rising] Host: $(hostname)  Env: $CONDA_DEFAULT_ENV  Workdir: $PBS_O_WORKDIR"
echo "[tprior_rising] Start: $(date)"

# --- Named paths ---
CONFIG="configs/synth/marapi_mogi_rising_temporalprior.json"
SAVE_DIR="saved/temporalprior_marapi_mogi_rising/run"
TRUTH_JSON="synthetic/cubes/marapi_mogi_rising_combined/marapi_mogi_rising_combined_truth.json"
SERIES_CSV="$SAVE_DIR/uspace_series.csv"
# Deterministic recovery-figure stem (lives at the fixed save-dir root, NOT inside the
# timestamped run dir, so the output path is known ahead of time).
OUT_STEM="$SAVE_DIR/param_recovery_temporalprior"

# --- Step 1/3: single-run training with the causal temporal prior ---
echo "[tprior_rising] Step 1/3: training (temporal prior, single run)..."
python train_pila.py --config "$CONFIG"

# --- Step 2/3: locate the freshly-trained checkpoint (newest model_best.pth) ---
CKPT="$(find "$SAVE_DIR" -name model_best.pth -printf '%T@ %p\n' | sort -nr | head -1 | cut -d' ' -f2-)"
if [ -z "$CKPT" ]; then
  echo "[tprior_rising] ERROR: no model_best.pth under $SAVE_DIR" >&2
  exit 1
fi
echo "[tprior_rising] Checkpoint: $CKPT"

# --- Step 2b: dump the per-epoch u-space series (u_mean/u_lnvar/u_std + physical) ---
echo "[tprior_rising] Step 2/3: dumping per-epoch u-space series..."
python dump_uspace_series.py --config "$CONFIG" --resume "$CKPT" --out "$SERIES_CSV"

# --- Step 3/3: overlay recovered per-epoch parameters vs synthetic ground truth ---
echo "[tprior_rising] Step 3/3: plotting recovered vs truth..."
python plot_iterprior_vs_truth.py \
  --series "$SERIES_CSV" \
  --truth "$TRUTH_JSON" \
  --out "$OUT_STEM" \
  --label "Option A (temporal prior)"

echo "[tprior_rising] Param-recovery figure: $PBS_O_WORKDIR/${OUT_STEM}.png"
echo "[tprior_rising] Finished: $(date)"
