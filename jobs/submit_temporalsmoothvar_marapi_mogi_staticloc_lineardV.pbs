#!/bin/bash
# Usage:       qsub jobs/submit_temporalsmoothvar_marapi_mogi_staticloc_lineardV.pbs
# Description: Temporal-smoothness (variance) run on the synthetic staticloc_lineardV cube.
#              Stage-B sequence loader (seq_len=7) feeds consecutive-epoch windows so the
#              temporal-smoothness penalty fires; temporal_prior is OFF. Same KL recipe as
#              the *_baseline configs (use_kl_term_z_phy=true, beta_max_z_phy=0.5) so this
#              isolates the effect of the smoothness term.
#              train -> dump per-epoch u-space series -> plot recovered vs truth.
# Date:        2026-07-10
#PBS -N tsvar_stat
#PBS -P eos_btaisne
#PBS -q qintel_wfly
#PBS -l nodes=1:ppn=8
#PBS -l walltime=12:00:00
#PBS -l mem=16gb
#PBS -j oe
#PBS -o logs/tsvar_stat_pbs.log

set -e
cd "$PBS_O_WORKDIR"

# --- Environment (project env is 'pila', NOT base) ---
source /eos-rs/miniconda3/etc/profile.d/conda.sh
conda activate pila
export PYTHONPATH="${PYTHONPATH}:$PBS_O_WORKDIR"

echo "[tsvar_stat] Host: $(hostname)  Env: $CONDA_DEFAULT_ENV  Workdir: $PBS_O_WORKDIR"
echo "[tsvar_stat] Start: $(date)"

# --- Named paths ---
CONFIG="configs/synth/marapi_mogi_staticloc_lineardV_temporalsmoothvar.json"
SAVE_DIR="saved/temporalsmoothvar_marapi_mogi_staticloc_lineardV/run"
TRUTH_JSON="synthetic/cubes/marapi_mogi_staticloc_lineardV/marapi_mogi_staticloc_lineardV_truth.json"
SERIES_CSV="$SAVE_DIR/uspace_series.csv"
OUT_STEM="$SAVE_DIR/param_recovery_temporalsmoothvar_staticloc_lineardV"

# --- Step 1/3: sequence-loader training with the temporal-smoothness penalty ---
echo "[tsvar_stat] Step 1/3: training (variance temporal smoothness)..."
python train_pila.py --config "$CONFIG"

# --- Step 2/3: locate the freshly-trained checkpoint (newest model_best.pth) ---
CKPT="$(find "$SAVE_DIR" -name model_best.pth -printf '%T@ %p\n' | sort -nr | head -1 | cut -d' ' -f2-)"
if [ -z "$CKPT" ]; then
  echo "[tsvar_stat] ERROR: no model_best.pth under $SAVE_DIR" >&2
  exit 1
fi
echo "[tsvar_stat] Checkpoint: $CKPT"

# --- Step 2b: dump the per-epoch u-space series (per-epoch inference; loader-agnostic) ---
echo "[tsvar_stat] Step 2/3: dumping per-epoch u-space series..."
python dump_uspace_series.py --config "$CONFIG" --resume "$CKPT" --out "$SERIES_CSV"

# --- Step 3/3: overlay recovered per-epoch parameters vs synthetic ground truth ---
echo "[tsvar_stat] Step 3/3: plotting recovered vs truth..."
python plot_iterprior_vs_truth.py \
  --series "$SERIES_CSV" \
  --truth "$TRUTH_JSON" \
  --out "$OUT_STEM" \
  --label "Temporal smooth (variance), static loc + linear dV"

echo "[tsvar_stat] Param-recovery figure: $PBS_O_WORKDIR/${OUT_STEM}.png"
echo "[tsvar_stat] Finished: $(date)"
