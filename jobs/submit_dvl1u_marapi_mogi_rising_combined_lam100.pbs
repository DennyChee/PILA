#!/bin/bash
# Usage:       qsub jobs/submit_dvl1u_marapi_mogi_rising_combined_lam100.pbs
# Description: u-space dV-L1 sparsity penalty, lambda=100, on the SIGMOID-ramp dV synthetic
#              cube (marapi_mogi_rising_combined). The penalty acts in PRE-sigmoid (u) space so its pull does
#              NOT vanish at the rail -- quiescent early epochs should collapse to dV~=0 while
#              the late high-dV rise is still recovered. train -> dump u-space series -> plot.
# Date:        2026-07-27
#PBS -N dvl1u_lam100
#PBS -P eos_btaisne
#PBS -q qintel_wfly
#PBS -l nodes=1:ppn=8
#PBS -l walltime=12:00:00
#PBS -l mem=16gb
#PBS -j oe
#PBS -o logs/dvl1u_combined_lam100_pbs.log

set -e
cd "$PBS_O_WORKDIR"

# --- Environment (project env is 'pila', NOT base) ---
source /eos-rs/miniconda3/etc/profile.d/conda.sh
conda activate pila
export PYTHONPATH="${PYTHONPATH}:$PBS_O_WORKDIR"

echo "[dvl1u_lam100] Host: $(hostname)  Env: $CONDA_DEFAULT_ENV  Workdir: $PBS_O_WORKDIR"
echo "[dvl1u_lam100] Start: $(date)  u-space dV-L1 lambda=100"

# --- Named paths (sigmoid-ramp dV cube + its ground-truth trajectory) ---
CONFIG="configs/synth/marapi_mogi_rising_combined_dvl1u_lam100.json"
SAVE_DIR="saved/dvl1u_marapi_mogi_rising_combined/lam100"
TRUTH_JSON="synthetic/cubes/marapi_mogi_rising_combined/marapi_mogi_rising_combined_truth.json"
SERIES_CSV="$SAVE_DIR/uspace_series.csv"
OUT_STEM="$SAVE_DIR/param_recovery_dvl1u_combined_lam100"

# --- Step 1/3: single-run training (u-space dV-L1 penalty via dv_l1_weight + dv_penalty_space) ---
echo "[dvl1u_lam100] Step 1/3: training..."
python train_pila.py --config "$CONFIG"

# --- Step 2/3: locate the freshly-trained checkpoint (newest model_best.pth) ---
CKPT="$(find "$SAVE_DIR" -name model_best.pth -printf '%T@ %p\n' | sort -nr | head -1 | cut -d' ' -f2-)"
if [ -z "$CKPT" ]; then
  echo "[dvl1u_lam100] ERROR: no model_best.pth under $SAVE_DIR" >&2
  exit 1
fi
echo "[dvl1u_lam100] Checkpoint: $CKPT"

# --- Step 2b: dump the per-epoch u-space series ---
echo "[dvl1u_lam100] Step 2/3: dumping per-epoch u-space series..."
python dump_uspace_series.py --config "$CONFIG" --resume "$CKPT" --out "$SERIES_CSV"

# --- Step 3/3: overlay recovered per-epoch parameters vs synthetic ground truth ---
echo "[dvl1u_lam100] Step 3/3: plotting recovered vs truth..."
python plot_iterprior_vs_truth.py \
  --series "$SERIES_CSV" \
  --truth "$TRUTH_JSON" \
  --out "$OUT_STEM" \
  --label "dV-L1 (u-space) lambda=100, sigmoid dV"

echo "[dvl1u_lam100] Param-recovery figure: $PBS_O_WORKDIR/${OUT_STEM}.png"
echo "[dvl1u_lam100] Finished: $(date)"
