#!/bin/bash
# Usage:       qsub jobs/submit_temporalsmoothvar_marapi_mogi_staticloc_sigmoiddV.pbs
# Description: Variance temporal smoothness (seq loader, include_dv) on the sigmoid-dV cube.
#              train -> dump per-epoch u-space series -> plot recovered vs truth.
# Date:        2026-07-10
#PBS -N sig_tsvar
#PBS -P eos_btaisne
#PBS -q qintel_wfly
#PBS -l nodes=1:ppn=8
#PBS -l walltime=12:00:00
#PBS -l mem=16gb
#PBS -j oe
#PBS -o logs/sig_tsvar_pbs.log

set -e
cd "$PBS_O_WORKDIR"
source /eos-rs/miniconda3/etc/profile.d/conda.sh
conda activate pila
export PYTHONPATH="${PYTHONPATH}:$PBS_O_WORKDIR"
echo "[sig_tsvar] Host: $(hostname)  Env: $CONDA_DEFAULT_ENV"
echo "[sig_tsvar] Start: $(date)"

CONFIG="configs/synth/marapi_mogi_staticloc_sigmoiddV_temporalsmoothvar.json"
SAVE_DIR="saved/temporalsmoothvar_marapi_mogi_staticloc_sigmoiddV/run"
TRUTH_JSON="synthetic/cubes/marapi_mogi_staticloc_sigmoiddV/marapi_mogi_staticloc_sigmoiddV_truth.json"
DUMP_CFG="$SAVE_DIR/dumpcfg_pointloader.json"
SERIES_CSV="$SAVE_DIR/uspace_series.csv"
OUT_STEM="$SAVE_DIR/param_recovery_temporalsmoothvar_sigmoiddV"

echo "[sig_tsvar] Step 1/3: training..."
python train_pila.py --config "$CONFIG"

CKPT="$(find "$SAVE_DIR" -name model_best.pth -printf '%T@ %p\n' | sort -nr | head -1 | cut -d' ' -f2-)"
if [ -z "$CKPT" ]; then echo "[sig_tsvar] ERROR: no model_best.pth under $SAVE_DIR" >&2; exit 1; fi
echo "[sig_tsvar] Checkpoint: $CKPT"

# dump_uspace_series does per-epoch inference and needs the POINT loader (yields 'date').
# Patch the trained run's config type_test -> InSARh5DataLoader (no-op if already point).
RUN_CFG="$(dirname "$CKPT")/config.json"
python -c "import json,sys; c=json.load(open(sys.argv[1])); c['data_loader']['type_test']='InSARh5DataLoader'; json.dump(c,open(sys.argv[2],'w'))" "$RUN_CFG" "$DUMP_CFG"

echo "[sig_tsvar] Step 2/3: dumping per-epoch u-space series..."
python dump_uspace_series.py --config "$DUMP_CFG" --resume "$CKPT" --out "$SERIES_CSV"

echo "[sig_tsvar] Step 3/3: plotting recovered vs truth..."
python plot_iterprior_vs_truth.py --series "$SERIES_CSV" --truth "$TRUTH_JSON" --out "$OUT_STEM" --label "Temporal smooth (variance), sigmoid dV"

echo "[sig_tsvar] Finished: $(date)"
