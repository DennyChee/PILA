#!/bin/bash
# Usage:       qsub jobs/submit_temporalprior_marapi_mogi_rising_lineardV.pbs
# Description: Option A (causal per-sample TEMPORAL PRIOR) on a synthetic Mogi test with a
#              LINEAR dV ramp (marapi_mogi_rising_lineardV: same moving-source geometry as
#              rising_combined, but dV increases LINEARLY 1e6 -> 8e7 m^3 instead of the
#              sigmoid S-curve). SINGLE training run: train -> dump per-epoch u-space series
#              -> plot recovered parameters vs synthetic ground truth.
# Date:        2026-07-09
#PBS -N tprior_lineardV
#PBS -P eos_btaisne
#PBS -q qintel_wfly
#PBS -l nodes=1:ppn=8
#PBS -l walltime=12:00:00
#PBS -l mem=16gb
#PBS -j oe
#PBS -o logs/tprior_lineardV_pbs.log

set -e
cd "$PBS_O_WORKDIR"

# --- Environment (project env is 'pila', NOT base) ---
source /eos-rs/miniconda3/etc/profile.d/conda.sh
conda activate pila
export PYTHONPATH="${PYTHONPATH}:$PBS_O_WORKDIR"

echo "[tprior_lineardV] Host: $(hostname)  Env: $CONDA_DEFAULT_ENV  Workdir: $PBS_O_WORKDIR"
echo "[tprior_lineardV] Start: $(date)"

# --- Named paths (cube already generated by synthetic.generate_timeseries) ---
CONFIG="configs/synth/marapi_mogi_rising_lineardV_temporalprior.json"
SAVE_DIR="saved/temporalprior_marapi_mogi_rising_lineardV/run"
TRUTH_JSON="synthetic/cubes/marapi_mogi_rising_lineardV/marapi_mogi_rising_lineardV_truth.json"
SERIES_CSV="$SAVE_DIR/uspace_series.csv"
# Deterministic recovery-figure stem (fixed save-dir root, not the timestamped run dir).
OUT_STEM="$SAVE_DIR/param_recovery_temporalprior_lineardV"

# --- Step 1/3: single-run training with the causal temporal prior ---
echo "[tprior_lineardV] Step 1/3: training (temporal prior, single run)..."
python train_pila.py --config "$CONFIG"

# --- Step 2/3: locate the freshly-trained checkpoint (newest model_best.pth) ---
CKPT="$(find "$SAVE_DIR" -name model_best.pth -printf '%T@ %p\n' | sort -nr | head -1 | cut -d' ' -f2-)"
if [ -z "$CKPT" ]; then
  echo "[tprior_lineardV] ERROR: no model_best.pth under $SAVE_DIR" >&2
  exit 1
fi
echo "[tprior_lineardV] Checkpoint: $CKPT"

# --- Step 2b: dump the per-epoch u-space series (u_mean/u_lnvar/u_std + physical) ---
echo "[tprior_lineardV] Step 2/3: dumping per-epoch u-space series..."
python dump_uspace_series.py --config "$CONFIG" --resume "$CKPT" --out "$SERIES_CSV"

# --- Step 3/3: overlay recovered per-epoch parameters vs synthetic ground truth ---
echo "[tprior_lineardV] Step 3/3: plotting recovered vs truth..."
python plot_iterprior_vs_truth.py \
  --series "$SERIES_CSV" \
  --truth "$TRUTH_JSON" \
  --out "$OUT_STEM" \
  --label "Option A (temporal prior), linear dV"

echo "[tprior_lineardV] Param-recovery figure: $PBS_O_WORKDIR/${OUT_STEM}.png"
echo "[tprior_lineardV] Finished: $(date)"
