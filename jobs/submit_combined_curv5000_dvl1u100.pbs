#!/bin/bash
# Usage:       qsub jobs/submit_combined_curv5000_dvl1u100.pbs
# Description: COMBINED prior on the synthetic cube marapi_mogi_rising_combined:
#              temporal curvature smoothing (weight=5000) + dV-L1 in u-space
#              (lambda=100). train -> dump per-epoch u-space series ->
#              plot recovered vs truth.
# Date:        2026-07-28
#PBS -N combined_curv5000_dvl1u100
#PBS -P eos_btaisne
#PBS -q qintel_wfly
#PBS -l nodes=1:ppn=8
#PBS -l walltime=12:00:00
#PBS -l mem=16gb
#PBS -j oe
#PBS -o logs/combined_curv5000_dvl1u100_marapi_mogi_rising_combined_pbs.log

set -e
cd "$PBS_O_WORKDIR"

# --- Environment (project env is 'pila', NOT base) ---
source /eos-rs/miniconda3/etc/profile.d/conda.sh
conda activate pila
export PYTHONPATH="${PYTHONPATH}:$PBS_O_WORKDIR"

echo "[combined_curv5000_dvl1u100] Host: $(hostname)  Env: $CONDA_DEFAULT_ENV  Workdir: $PBS_O_WORKDIR"
echo "[combined_curv5000_dvl1u100] Start: $(date)  curvature=5000  dV-L1(u) lambda=100  cube=marapi_mogi_rising_combined"

# --- Named paths (combined-prior config + ground-truth trajectory) ---
CONFIG="configs/synth/marapi_mogi_rising_combined_curv5000_dvl1u100.json"
SAVE_DIR="saved/combined_curvdvl1u_marapi_mogi_rising_combined/curv5000_dvl1u100"
TRUTH_JSON="synthetic/cubes/marapi_mogi_rising_combined/marapi_mogi_rising_combined_truth.json"
SERIES_CSV="$SAVE_DIR/uspace_series.csv"
OUT_STEM="$SAVE_DIR/param_recovery_combined_curv5000_dvl1u100"

# --- Step 1/3: single-run training (curvature + u-space dV-L1 both active) ---
echo "[combined_curv5000_dvl1u100] Step 1/3: training..."
python train_pila.py --config "$CONFIG"

# --- Step 2/3: locate the freshly-trained checkpoint (newest model_best.pth) ---
CKPT="$(find "$SAVE_DIR" -name model_best.pth -printf '%T@ %p\n' | sort -nr | head -1 | cut -d' ' -f2-)"
if [ -z "$CKPT" ]; then
  echo "[combined_curv5000_dvl1u100] ERROR: no model_best.pth under $SAVE_DIR" >&2
  exit 1
fi
echo "[combined_curv5000_dvl1u100] Checkpoint: $CKPT"

# --- Step 2b: dump the per-epoch u-space series (uses InSARh5DataLoader test loader) ---
echo "[combined_curv5000_dvl1u100] Step 2/3: dumping per-epoch u-space series..."
python dump_uspace_series.py --config "$CONFIG" --resume "$CKPT" --out "$SERIES_CSV"

# --- Step 3/3: overlay recovered per-epoch parameters vs synthetic ground truth ---
echo "[combined_curv5000_dvl1u100] Step 3/3: plotting recovered vs truth..."
python plot_iterprior_vs_truth.py \
  --series "$SERIES_CSV" \
  --truth "$TRUTH_JSON" \
  --out "$OUT_STEM" \
  --label "Curvature w=5000 + dV-L1(u) lambda=100, marapi_mogi_rising_combined"

echo "[combined_curv5000_dvl1u100] Param-recovery figure: $PBS_O_WORKDIR/${OUT_STEM}.png"
echo "[combined_curv5000_dvl1u100] Finished: $(date)"
