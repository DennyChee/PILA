#!/bin/bash
# Usage:       qsub submit_iterprior_marapi_mogi_rising.pbs
# Description: Sequential "previous-epoch-as-prior" encoder retraining on the MOVING
#              (rising) synthetic Mogi cube (marapi_mogi_rising_combined, 76 epochs,
#              128x128=16384 px). Trains a base encoder (E0), then runs
#              run_iterative_prior_refit.py: each epoch's raw guess becomes the KL prior
#              mean for the next epoch's warm-start retraining round. Writes per-epoch
#              parameter series + timing/scale/drift stats, then a comparison plot.
# Date:        2026-07-01
#PBS -N iterprior_mogi_rising
#PBS -P eos_btaisne
#PBS -q qintel_wfly
#PBS -l nodes=1:ppn=8
#PBS -l walltime=12:00:00
#PBS -l mem=16gb
#PBS -j oe
#PBS -o logs/iterprior_mogi_rising_pbs.log

set -e
cd "$PBS_O_WORKDIR"

# --- Environment (project env is 'pila', NOT base) ---
source /eos-rs/miniconda3/etc/profile.d/conda.sh
conda activate pila
export PYTHONPATH="${PYTHONPATH}:$PBS_O_WORKDIR"

echo "[iterprior_mogi_rising] Host: $(hostname)  Env: $CONDA_DEFAULT_ENV  Workdir: $PBS_O_WORKDIR"
echo "[iterprior_mogi_rising] Start: $(date)"

# --- Named paths (edit here if the cube/config move) ---
BASE_CONFIG="configs/synth/marapi_mogi_rising_base.json"
ITER_CONFIG="configs/synth/marapi_mogi_rising_iterprior.json"
BASE_SAVE_DIR="saved/iterprior_marapi_mogi_rising/base"

# --- Step 1: train the base encoder (E0) on the moving cube (standard, KL off) ---
echo "[iterprior_mogi_rising] Step 1/3: training base encoder E0..."
python train_pila.py --config "$BASE_CONFIG"

# --- Step 2: locate the freshly-trained base checkpoint (newest model_best.pth) ---
BASE_CKPT="$(find "$BASE_SAVE_DIR" -name model_best.pth -printf '%T@ %p\n' | sort -nr | head -1 | cut -d' ' -f2-)"
if [ -z "$BASE_CKPT" ]; then
  echo "[iterprior_mogi_rising] ERROR: no base model_best.pth under $BASE_SAVE_DIR" >&2
  exit 1
fi
echo "[iterprior_mogi_rising] Base checkpoint: $BASE_CKPT"

# --- Step 3: sequential previous-epoch-as-prior retraining over all 76 epochs ---
echo "[iterprior_mogi_rising] Step 2/3: sequential prior retraining (all epochs)..."
SERIES_CSV="$BASE_SAVE_DIR/iterprior_series.csv"
python run_iterative_prior_refit.py \
  --config "$ITER_CONFIG" \
  --resume "$BASE_CKPT" \
  --out "$SERIES_CSV"

# --- Step 4: comparison plot of the recovered parameter time series ---
echo "[iterprior_mogi_rising] Step 3/3: plotting parameter series..."
python plot_iterprior_series.py --series "$SERIES_CSV" || \
  echo "[iterprior_mogi_rising] WARN: plotting failed (series CSV still written)."

echo "[iterprior_mogi_rising] Finished: $(date)"
