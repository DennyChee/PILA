#!/bin/bash
# Usage:       qsub submit_iterprior_marapi_mogi_move_loc_hisnr.pbs
# Description: HIGH-SNR (30 dB) diagnostic of move-location-only test. Same cube as move_loc
#              (constant dV=4e7, d=5000; only xcen/ycen migrate) but noise scaled to 30 dB
#              (~1.7 mm vs ~55 mm signal). Question: does a signal-dominated field recover
#              d/dV cleanly WITHOUT a prior? If d/dV still jump here, the trade-off is not
#              noise-limited. Trains base E0 on the clean cube, then the LOOSE (control) refit.
# Date:        2026-07-07
#PBS -N iterprior_move_loc_hisnr
#PBS -P eos_btaisne
#PBS -q qintel_wfly
#PBS -l nodes=1:ppn=8
#PBS -l walltime=12:00:00
#PBS -l mem=16gb
#PBS -j oe
#PBS -o logs/iterprior_move_loc_hisnr_pbs.log

set -e
cd "$PBS_O_WORKDIR"

# --- Environment (project env is 'pila', NOT base) ---
source /eos-rs/miniconda3/etc/profile.d/conda.sh
conda activate pila
export PYTHONPATH="${PYTHONPATH}:$PBS_O_WORKDIR"

echo "[move_loc_hisnr] Host: $(hostname)  Env: $CONDA_DEFAULT_ENV  Workdir: $PBS_O_WORKDIR"
echo "[move_loc_hisnr] Start: $(date)"

# --- Named paths (cube already generated; do NOT regenerate -> fixed noise realization) ---
BASE_CONFIG="configs/synth/marapi_mogi_move_loc_hisnr_base.json"
ITER_CONFIG="configs/synth/marapi_mogi_move_loc_hisnr_iterprior.json"
BASE_SAVE_DIR="saved/iterprior_marapi_mogi_move_loc_hisnr/base"
TRUTH_JSON="synthetic/cubes/marapi_mogi_move_loc_hisnr/marapi_mogi_move_loc_hisnr_truth.json"

# --- Step 1/3: train the base encoder E0 (standard training, KL off) ---
echo "[move_loc_hisnr] Step 1/3: training base encoder E0..."
python train_pila.py --config "$BASE_CONFIG"

# --- Step 2/3: locate the freshly-trained base checkpoint (newest model_best.pth) ---
BASE_CKPT="$(find "$BASE_SAVE_DIR" -name model_best.pth -printf '%T@ %p\n' | sort -nr | head -1 | cut -d' ' -f2-)"
if [ -z "$BASE_CKPT" ]; then
  echo "[move_loc_hisnr] ERROR: no base model_best.pth under $BASE_SAVE_DIR" >&2
  exit 1
fi
echo "[move_loc_hisnr] Base checkpoint: $BASE_CKPT"

# --- Step 3/3: LOOSE (control) sequential previous-epoch-as-prior refit over all epochs ---
echo "[move_loc_hisnr] Step 2/3: sequential prior retraining (LOOSE control)..."
SERIES_CSV="$BASE_SAVE_DIR/iterprior_series.csv"
python run_iterative_prior_refit.py \
  --config "$ITER_CONFIG" \
  --resume "$BASE_CKPT" \
  --out "$SERIES_CSV"

echo "[move_loc_hisnr] Step 3/3: plotting recovered vs truth..."
python plot_iterprior_vs_truth.py --series "$SERIES_CSV" --truth "$TRUTH_JSON" || \
  echo "[move_loc_hisnr] WARN: plotting failed (series CSV still written)."

echo "[move_loc_hisnr] Finished: $(date)"
