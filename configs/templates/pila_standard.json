{
  "name": "__SCENARIO_ID__",
  "n_gpu": 1,
  "arch": {
    "type": "PHYS_VAE_SMPL",
    "args": {
      "encoder_type": "mlp",
      "input_dim": 16384,
      "hidden_dim": 8,
      "time_feat_dim": 4,
      "use_time_in_residual": false,
      "insar": "__INSAR__"
    },
    "phys_vae": {
      "no_phy": false,
      "dim_z_aux": 4,
      "dim_z_phy": "__DIM_Z_PHY__",
      "activation": "elu",
      "num_units_feat": 128,
      "hidlayers_feat": [
        128
      ],
      "hidlayers_z_aux": [
        128
      ],
      "hidlayers_z_phy": [
        128
      ],
      "residual_rank": 4,
      "tau_init": 3.0,
      "tau_final": 1.0,
      "tau_warmup_epochs": 20,
      "r_init": 0.0,
      "r_final": 1.0,
      "r_warmup_epochs": 30,
      "ortho_penalty_weight": 0.1,
      "coeff_penalty_weight": 0.0,
      "delta_penalty_weight": 0.0,
      "detach_x_P_for_bias": true,
      "temporal_prior": {
        "enabled": false,
        "ema_decay": 0.9,
        "prior_std": 1.5,
        "loc_std": 0.2,
        "amp_std": 0.4
      }
    }
  },
  "data_loader": {
    "type": "InSARSeqh5DataLoader",
    "type_test": "InSARh5DataLoader",
    "args": {
      "insar": "__INSAR__",
      "batch_size": 8,
      "shuffle": true,
      "validation_split": 0.0,
      "num_workers": 0,
      "with_const": false,
      "seq_len": 7,
      "mode": "train"
    },
    "data_dir_valid": "__INSAR__",
    "data_dir_test": "__INSAR__"
  },
  "optimizer": {
    "type": "Adam",
    "args": {
      "lr": 0.0003,
      "weight_decay": 0.0001,
      "amsgrad": true
    }
  },
  "loss": "mse_loss",
  "loss_test": "mse_loss",
  "metrics": [],
  "lr_scheduler": {
    "type": "CosineAnnealingLR",
    "args": {
      "T_max": 150
    }
  },
  "trainer": {
    "epochs": 150,
    "save_dir": "__SAVE_DIR__",
    "save_period": 10,
    "log_step": 5,
    "verbosity": 2,
    "monitor": "min val_rec_loss",
    "early_stop": 100,
    "input_key": "displacement",
    "output_key": "displacement",
    "stablize_grad": true,
    "grad_clip_norm": 1.0,
    "tensorboard": false,
    "wandb": false,
    "phys_vae": {
      "epochs_pretrain": 0,
      "kl_warmup_epochs": 30,
      "balance_gate": 0.001,
      "balance_data_aug": 1.0,
      "balance_residual": 0.001,
      "use_kl_term_z_phy": true,
      "beta_max_z_phy": 0.5,
      "use_kl_term_z_aux": false,
      "beta_max_z_aux": 1.0,
      "use_capacity_control": false,
      "C_max": 4.0,
      "C_gamma": 10.0,
      "beta_aux": 1.0,
      "edge_penalty_weight": 0.0,
      "edge_penalty_power": 1.0,
      "temporal_smoothness_weight": 15000.0,
      "use_ema_prior": false,
      "ema_momentum": 0.999,
      "temporal_smoothness_mode": "curvature",
      "temporal_smoothness_include_dv": true,
      "dv_l1_weight": 300.0,
      "dv_l2_weight": 0.0,
      "dv_penalty_space": "u"
    }
  },
  "_template_note": "PILA standard single-source cell (curvature 15000 + dV-L1(u) 300, sequence loader), from configs/synth/marapi_mogi_move_loc_curv15000_dvl1u300_pathfix_dvbox.json (legacy). Placeholders are filled by methods/pila/make_config.py. Overlays: configs/templates/overlay_*.json"
}