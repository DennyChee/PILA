#!/bin/bash
# Usage:       qsub submit_sierranegra_sun69_A.pbs
# Description: Submit the PILA Sierra Negra Sun (1969) penny-shaped crack InSAR
#              (Stage A, MLP) training job to PBS. Trains the physics-VAE on the
#              whole LOS time series (each epoch an independent sample) to invert
#              for the penny-crack source. Mirrors submit_sierranegra_mogi_A.pbs.
# Date:        2026-06-17
#PBS -N SN_Sun69_A
#PBS -P eos_btaisne
#PBS -q qintel_wfly
#PBS -l nodes=1:ppn=8
#PBS -l walltime=12:00:00
#PBS -l mem=16gb
#PBS -j oe
#PBS -o logs/SN_Sun69_A_pbs.log

# --- Move to the directory the job was submitted from (the PILA repo root) ---
cd "$PBS_O_WORKDIR"

# --- Activate the PILA conda environment (torch 2.0.0, CPU-only on this node) ---
source /eos-rs/miniconda3/etc/profile.d/conda.sh
conda activate pila

# --- Make the repo importable (data_loader, model, datasets, ... are top-level pkgs) ---
export PYTHONPATH="${PYTHONPATH}:$PBS_O_WORKDIR"

echo "[SN_Sun69_A] Host: $(hostname)  Env: $CONDA_DEFAULT_ENV  Workdir: $PBS_O_WORKDIR"
echo "[SN_Sun69_A] Starting training at $(date)"

# --- Train Sun69 InSAR A (whole-timeseries, epochs independent) ---
python train_pila.py --config configs/phys_smpl/SierraNegra_Sun69_InSAR_A.json

echo "[SN_Sun69_A] Finished at $(date)"
